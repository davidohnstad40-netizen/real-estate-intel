ANTHROPIC_API_KEY=your_key_here
DB_PATH=./data/rei.duckdb

# BatchSkipTracing.com API key -- enables on-demand paid skip trace ($0.18/property)
# Get yours at: https://batchskiptracing.com (create account -> API -> generate key)
# Leave blank to use free-only mode (FastPeopleSearch, ~50-60% hit rate)
BATCH_SKIP_API_KEY=

# Email alerts (optional — daily HTML digest + tier upgrade notifications)
# Gmail: use an App Password (myaccount.google.com/apppasswords), NOT your login password
ALERT_EMAIL_TO=you@email.com
ALERT_EMAIL_FROM=sender@gmail.com
ALERT_EMAIL_PASSWORD=your-16-char-app-password
# Outlook/Hotmail alternative:
# ALERT_SMTP_HOST=smtp-mail.outlook.com
# ALERT_SMTP_PORT=587
